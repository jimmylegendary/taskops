{
  "name": "taskops",
  "version": "0.5.10",
  "description": "Markdown-first task/run graph CLI with EoW closure, delegation, and Obsidian-friendly TaskOps work trees.",
  "bin": {
    "taskops": "./bin/taskops.js"
  },
  "type": "module",
  "scripts": {
    "build": "node -e \"console.log('taskops CLI is plain ESM; no build step needed')\"",
    "typecheck": "node -e \"console.log('taskops CLI uses runtime smoke verification; no static typecheck configured')\"",
    "test": "node ./scripts/smoke.mjs && node ./scripts/readiness-gate.mjs && node ./scripts/semantic-acceptance-review.mjs && node ./scripts/closure-summary-policy.mjs && node ./scripts/runtime-adapters.mjs && node ./scripts/audit-gates.mjs",
    "test:readiness-gate": "node ./scripts/readiness-gate.mjs",
    "test:semantic-acceptance": "node ./scripts/semantic-acceptance-review.mjs",
    "test:closure-summary-policy": "node ./scripts/closure-summary-policy.mjs",
    "test:workflow": "node ./scripts/workflow-e2e.mjs"
  },
  "files": [
    "bin",
    "lib-taskops.js",
    "lib-audit.js",
    "lib-runner.js",
    "lib-runtime-adapters.js",
    "lib-queue.js",
    "lib-orchestrator.js",
    "lib-daemon.js",
    "README.md",
    "scripts/readiness-gate.mjs",
    "scripts/semantic-acceptance-review.mjs",
    "scripts/closure-summary-policy.mjs",
    "scripts/runtime-adapters.mjs",
    "scripts/audit-gates.mjs",
    "scripts/smoke.mjs",
    "scripts/workflow-e2e.mjs"
  ],
  "license": "MIT",
  "keywords": [
    "taskops",
    "task-graph",
    "run-graph",
    "markdown",
    "obsidian",
    "workflow",
    "agents",
    "delegation",
    "eow",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jimmylegendary/taskops.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/jimmylegendary/taskops#readme",
  "bugs": {
    "url": "https://github.com/jimmylegendary/taskops/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
